      "attributes": {
        "deployment": {
          "cache-size-limit": 53687091200,
          "hosted-default-max-concurrent-jobs": 0,
          "images-allowed-registries": [],
          "job-log-max-bytes": 67108864,
          "job-rate-limit": {
            "burst": 40,
